# Copy to .env, or export these. .env is git-ignored. Never commit real values.

# SAM 3.1 through the Meta Model API (the vision in the drive loop)
MODEL_API_KEY=

# Muse Spark Open through Baseten (parser fallback; optional)
BASETEN_API_KEY=
BASETEN_LLM_MODEL=meta-models/muse-spark-open-1026

# The tank
TANK_HOST=tank.local
TANK_TOKEN=
BENCH_TOKEN_FILE=/tmp/mitt/bench_token

# Raw mode: Llama on Ollama (optional)
OLLAMA_URL=http://localhost:11434
TANK_LLAMA_MODEL=llama3.2:3b
